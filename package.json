{
  "name": "agentdoor",
  "version": "0.2.0",
  "description": "Controlled test access for AI-assisted application development.",
  "main": "dist/delegation.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "privacy:check": "node scripts/privacy-check.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node --import tsx --test tests/browser.integration.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sunnylincc/AgentHatch.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Sunnylincc/AgentHatch/issues"
  },
  "homepage": "https://github.com/Sunnylincc/AgentHatch#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "agentdoor": "dist/main.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/delegation.js"
  },
  "types": "dist/delegation.d.ts"
}
